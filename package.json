{
  "name": "taskverify-backend",
  "version": "1.0.0",
  "description": "TaskVerify - AI-powered gig task verification with Squad escrow",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "seed": "ts-node src/seed.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "type-check": "tsc --noEmit",
    "test:ai": "ts-node src/test-ai.ts"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.6.5",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.11.4",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
