# TaskVerify Backend - Environment Configuration

## Database
DATABASE_URL=postgresql://user:password@localhost:5432/taskverify_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskverify_db

## Server
PORT=3001
NODE_ENV=development

## Squad API Integration
SQUAD_API_KEY=your_squad_api_key
SQUAD_WEBHOOK_SECRET=your_squad_webhook_secret
SQUAD_BASE_URL=https://api.squadco.com

## Anthropic Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key

## Webhook Configuration
WEBHOOK_VERIFICATION_URL=https://your-domain.com/api/v1/webhooks/verification
SQUAD_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/squad
